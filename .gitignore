# CHED Compliance - Git Ignore
# Security: never commit secrets
.env
.env.*
!.env.example

# Uploaded files & user content
/uploads/*
!/uploads/.htaccess
/uploads/archived/
!/uploads/.htaccess

# Logs (local only)
/logs/
*.log

# Cache
/system/storage/cache/*
!/system/storage/cache/.htaccess
/system/storage/cache/*.json

# OS & editors
Thumbs.db
.DS_Store
*.swp
*.bak
.idea/
.vscode/

# Composer (restore with `composer install`)
/vendor/

# Temp
exports/*
!exports/.htaccess
preview_cache/
tmp/

# Restrict opencode and important package files
.opencode/
.opencode
opencode.json
package-lock.json
package.json

# R2 migration ledger (operational record, contains no secrets)
/scripts/storage/

# Database dumps (contain user data) — never commit
*.sql
