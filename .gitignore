# CHED Compliance - Git Ignore
# Security: never commit secrets
.env
.env.*
!.env.example

# Uploaded files & user content
/uploads/*
!/uploads/.htaccess
/uploads/archived/
!/uploads/.htaccess

# Logs (local only)
/logs/
*.log

# Cache
/system/storage/cache/*
!/system/storage/cache/.htaccess
/system/storage/cache/*.json

# OS & editors
Thumbs.db
.DS_Store
*.swp
*.bak
.idea/
.vscode/

# Node
node_modules/

# Composer (restore with `composer install`)
/vendor/

# Local scripts, agent config
/scripts/
/.opencode/

# Temp
exports/*
!exports/.htaccess
preview_cache/
tmp/
