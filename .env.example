# Copy to .env and fill in. Every key is optional — code defaults below apply.

APP_DEBUG=false

# Database — DB_PASS must be set, there is no fallback to root/empty password
DB_HOST=127.0.0.1
DB_NAME=ched_compliance
DB_USER=ched_app
DB_PASS=

# File storage — outside the public web root
SECURE_STORAGE_PATH=C:\ched_secure_storage\documents\
TEMP_PATH=C:\ched_secure_storage\temp\

# SMTP (fail fast if empty — see the warning in the log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=CHED Compliance System

# Upload policy / notifications
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=pdf, doc, docx, jpg, jpeg, png, gif, webp, xls, xlsx, ppt, pptx
ALLOWED_EXTENSIONS_LABEL=PDF, DOC/DOCX, JPG/PNG/GIF/WEBP, XLS/XLSX, PPT/PPTX
EXPIRY_WARNING_DAYS=2
