
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ched_compliance
DB_USER=ched_app
DB_PASS=

# Managed MySQL over TLS (Aiven): path to the provider CA certificate.
# Leave empty for local XAMPP. On Render use /etc/secrets/ca.pem.
DB_SSL_CA=
DB_SSL_VERIFY=true
# Session sql_mode override. Aiven default includes ANSI (breaks "..." strings);
# recommended there: STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
DB_SQL_MODE=

# File storage — outside the public web root
SECURE_STORAGE_PATH=C:\ched_secure_storage\documents\
TEMP_PATH=C:\ched_secure_storage\temp\

STORAGE_DRIVER=local
APP_ENV=production

APP_HOST=

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# SMTP (fail fast if empty — see the warning in the log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=CHED Compliance System

# Upload policy / notifications
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=pdf, doc, docx, jpg, jpeg, png, gif, webp, xls, xlsx, ppt, pptx
ALLOWED_EXTENSIONS_LABEL=PDF, DOC/DOCX, JPG/PNG/GIF/WEBP, XLS/XLSX, PPT/PPTX
EXPIRY_WARNING_DAYS=2

# Realtime notifications (WebSocket)
WS_SECRET=
WS_INTERNAL_SECRET=
WS_HOST=localhost
WS_PORT=8080
WS_INTERNAL_PORT=8090
# Set to /ws behind a reverse proxy (Render); empty = connect to WS_HOST:WS_PORT
WS_PUBLIC_PATH=

# Email worker: 1 = don't spawn per request (a scheduled/looping worker sends)
EMAIL_DISABLE_SPAWN=
